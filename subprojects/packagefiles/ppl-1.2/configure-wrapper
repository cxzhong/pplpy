#!/bin/sh
# Wrapper around PPL's configure that generates a ppl.pc pkg-config file.
# Required because PPL 1.2 only ships ppl-config, not pkg-config support.
# The Meson external_project module needs a .pc file for dependency tracking.

set -e

srcdir=$(cd "$(dirname "$0")" && pwd)

# Run the real configure with all passed arguments.
"$srcdir/configure" "$@"

# Generate ppl.pc from our template using config.status
# (config.status knows all @prefix@, @exec_prefix@, etc. substitutions).
./config.status --file=ppl.pc:"$srcdir/ppl.pc.in"

# Append a pkgconfig install rule to the generated Makefile so that
# `make install` (run by the external_project module) also installs ppl.pc.
cat >> Makefile <<'PKGCONFIG_RULE'

# --- Added by pplpy configure-wrapper ---
install-data-am: install-pkgconfig

install-pkgconfig:
	@mkdir -p "$(DESTDIR)$(libdir)/pkgconfig"
	$(INSTALL_DATA) ppl.pc "$(DESTDIR)$(libdir)/pkgconfig/ppl.pc"
PKGCONFIG_RULE
